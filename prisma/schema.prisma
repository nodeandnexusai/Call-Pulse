datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  clientConfig  ClientConfig?
}

model ClientConfig {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  businessPhone         String    @unique
  twilioAccountSid      String
  twilioAuthToken       String
  twilioPhoneNumber     String
  whatsappPhoneNumberId String
  whatsappAccessToken   String
  isAutomationActive    Boolean   @default(false)
  messageTemplate       String    @default("Hi from {{business_name}}! We missed your call. How can we help you today?")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  logs                  CallLog[]
}

model CallLog {
  id             String       @id @default(cuid())
  clientConfigId String
  clientConfig   ClientConfig @relation(fields: [clientConfigId], references: [id], onDelete: Cascade)
  callerPhone    String
  callStatus     String
  messageStatus  String
  errorMessage   String?
  timestamp      DateTime     @default(now())
}